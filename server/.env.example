# Core runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Local infrastructure. For Azure Container Apps, use a managed MongoDB URI and
# a TLS Redis URI instead, for example mongodb+srv://... and rediss://....
# Local or Atlas MongoDB URI. The backend automatically accepts either MONGO_URI or MONGODB_URI.
# Azure MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/cartograph?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cartograph
REDIS_URL=redis://127.0.0.1:6379

# Public application origins.
# Azure values must be complete HTTPS origins with no trailing path:
# CLIENT_URL=https://<your-static-web-app>.azurestaticapps.net
# API_BASE_URL=https://<your-container-app>.<region>.azurecontainerapps.io
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Authentication. Generate a unique 32+ character value for every environment.
# Never commit the real value or expose it through a VITE_ client variable.
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# GitHub repository scanning. Optional, but recommended in Azure to avoid low
# unauthenticated GitHub API limits. This is not the GitHub OAuth app secret.
GITHUB_TOKEN=

# Optional OAuth providers. Register these callbacks with each provider:
# <API_BASE_URL>/api/auth/oauth/google/callback
# <API_BASE_URL>/api/auth/oauth/github/callback
# <API_BASE_URL>/api/auth/oauth/gitlab/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com

# Optional AI chat. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=CartoGraph

# Azure deployment metadata. These are non-secret values for deployment scripts
# or CI configuration; the CartoGraph backend does not read them at runtime.
# Store production secrets in Azure Container App secrets or GitHub Actions
# Secrets, rather than in this file.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_PRODUCTION_BRANCH=
GITHUB_REPOSITORY=


# Generated by MongoDB Atlas onboarding.
# This file contains sensitive credentials.
# DO NOT commit this file to version control.
# Store it securely (e.g. use a password manager or secrets vault).

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
